# 本地默认不需要 .env 文件；程序自动读取 config.json 和 storage-state.json。
# GitHub Actions 使用 Cookie-Editor 导出的完整 JSON 数组配置 DOUYIN_COOKIE Secret。
DOUYIN_STORAGE_STATE=
DOUYIN_COOKIE=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 邮件通知（可选）
# SMTP_SERVER=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_TO=
HEADLESS=false
